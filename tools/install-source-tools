#!/bin/sh
# Optional collectors' CLI dependencies, built for the target OS/architecture.
set -eu
profile_root=${AI_TOPICS_PROFILE:?Set AI_TOPICS_PROFILE to the destination profile}
mkdir -p "$profile_root/bin"
build_dir=$(mktemp -d)
trap 'rm -rf "$build_dir"' EXIT HUP INT TERM
GOBIN="$build_dir" go install github.com/Hyaxia/blogwatcher/cmd/blogwatcher@v0.0.2
install -m 755 "$build_dir/blogwatcher" "$profile_root/bin/blogwatcher-cli"
GOBIN="$build_dir" go install github.com/xdevplatform/xurl@v1.1.0
install -m 755 "$build_dir/xurl" "$profile_root/bin/xurl"

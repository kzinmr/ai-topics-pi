#!/bin/sh
set -eu
source_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export AI_TOPICS_SOURCE="$source_root"
if [ ! -f "$source_root/dist/cli.js" ]; then
  echo 'Build the TypeScript runner first: npm ci --ignore-scripts && npm run build' >&2
  exit 1
fi
exec node "$source_root/dist/cli.js" "$@"
